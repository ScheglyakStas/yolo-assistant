msgid_plural "You have corrected {n:,} photo(s) this session."
msgstr[0] "Sie haben in dieser Sitzung {n:,} Foto korrigiert."
msgstr[1] "Sie haben in dieser Sitzung {n:,} Fotos korrigiert."

