msgid "No prepared dataset. Finish Step 2 first."
msgstr "Нет подготовленного набора данных. Сначала завершите шаг 2."

#: yolo_assistant/app/core/autolabel.py:166 yolo_assistant/app/core/dataset.py:362 worker/commands/autolabel.py:166
