msgid "Next >"
msgstr "Следующее >"

#: yolo_assistant/app/ui/steps/verify_step.py:161
msgid "Only photos where nothing was found"
msgstr "Только фото, где ничего не найдено"

#: yolo_assistant/app/ui/steps/verify_step.py:164
msgid "Delete box"
msgstr "Удалить рамку"

#: yolo_assistant/app/ui/steps/verify_step.py:168
msgid "Revert photo"
msgstr "Отменить правки фото"

#: yolo_assistant/app/ui/steps/verify_step.py:182
msgid "Arrow keys or the mouse wheel move between photos. Drag on the photo to add a box the model missed; click a box and press Delete to remove it. Changes are saved as you make them."
msgstr "Переходите между фото клавишами со стрелками или колесом мыши. Чтобы добавить рамку, которую пропустила модель, обведите объект мышью; чтобы удалить рамку, щёлкните по ней и нажмите Delete. Изменения сохраняются сразу."

#: yolo_assistant/app/ui/steps/verify_step.py:363
msgid "{name} could not be opened. The file may have been moved or damaged since the dataset was prepared."
msgstr "Не удалось открыть {name}. Возможно, файл был перемещён или повреждён после подготовки набора данных."

#: yolo_assistant/app/ui/steps/verify_step.py:369
msgid "{n} line(s) of this photo's label file could not be read and are not shown. Changing the boxes here rewrites the file without them."
msgid_plural "{n} line(s) of this photo's label file could not be read and are not shown. Changing the boxes here rewrites the file without them."
msgstr[0] "{n} строку файла разметки этого фото не удалось прочитать, поэтому она не показана. Если изменить рамки здесь, файл будет перезаписан без неё."
msgstr[1] "{n} строки файла разметки этого фото не удалось прочитать, поэтому они не показаны. Если изменить рамки здесь, файл будет перезаписан без них."
msgstr[2] "{n} строк файла разметки этого фото не удалось прочитать, поэтому они не показаны. Если изменить рамки здесь, файл будет перезаписан без них."

#: yolo_assistant/app/ui/steps/verify_step.py:379
msgid "This photo has no label file yet -- autolabeling never reached it."
msgstr "У этого фото ещё нет файла разметки — авторазметка до него не дошла."

#: yolo_assistant/app/ui/steps/verify_step.py:381
msgid "Nothing was found in this photo."
msgstr "На этом фото ничего не найдено."

#: yolo_assistant/app/ui/steps/verify_step.py:386 yolo_assistant/app/ui/steps/verify_step.py:283
msgid "No prepared dataset to check yet."
msgstr "Пока нет подготовленного набора данных для проверки."

#: yolo_assistant/app/ui/steps/verify_step.py:388
msgid "Something was found in every photo of this class, so the filter has nothing to show. Untick it to look through them."
msgstr "На каждом фото этого класса что-то найдено, поэтому фильтру нечего показать. Снимите флажок, чтобы просмотреть их."

#: yolo_assistant/app/ui/steps/verify_step.py:392
msgid "This class has no photos in it."
msgstr "В этом классе нет фото."

#: yolo_assistant/app/ui/steps/verify_step.py:460
msgid "Every photo of this class was looked at and nothing was found in {share:.0%} of them."
msgstr "Все фото этого класса просмотрены; на {share:.0%} из них ничего не найдено."

#: yolo_assistant/app/ui/steps/verify_step.py:479
msgid "photo {position:,} of {shown:,} with nothing found, out of {total:,}"
msgstr "фото {position:,} из {shown:,} без находок (всего {total:,})"

#: yolo_assistant/app/ui/steps/verify_step.py:486
msgid "photo {position:,} of {shown:,}"
msgstr "фото {position:,} из {shown:,}"

#: yolo_assistant/app/ui/steps/verify_step.py:492
msgid "no boxes"
msgstr "нет рамок"

#: yolo_assistant/app/ui/steps/verify_step.py:492
msgid "{n:,} box"
msgid_plural "{n:,} boxes"
msgstr[0] "{n:,} рамка"
msgstr[1] "{n:,} рамки"
msgstr[2] "{n:,} рамок"

#: yolo_assistant/app/ui/steps/verify_step.py:493
msgid "edited"
msgstr "изменено"

#: yolo_assistant/app/ui/steps/verify_step.py:510
msgid "You have corrected {n:,} photo(s) this session."
msgid_plural "You have corrected {n:,} photo(s) this session."
msgstr[0] "За этот сеанс вы исправили {n:,} фотографию."
msgstr[1] "За этот сеанс вы исправили {n:,} фотографии."
msgstr[2] "За этот сеанс вы исправили {n:,} фотографий."

#: yolo_assistant/app/ui/steps/verify_step.py:544
msgid "Prepare your photos in Step 2 first; there are no labels to check yet."
msgstr "Сначала подготовьте фото на шаге 2; пока нет разметки для проверки."

#: yolo_assistant/app/ui/steps/verify_step.py:546
msgid "{n:,} photo(s) still have no labels. Finish autolabeling in Step 3 first, or there is nothing to check for them."
msgid_plural "{n:,} photo(s) still have no labels. Finish autolabeling in Step 3 first, or there is nothing to check for them."
msgstr[0] "{n:,} фотография ещё не размечена. Сначала завершите авторазметку на шаге 3, иначе проверять для неё нечего."
msgstr[1] "{n:,} фотографии ещё не размечены. Сначала завершите авторазметку на шаге 3, иначе проверять для них нечего."
msgstr[2] "{n:,} фотографий ещё не размечено. Сначала завершите авторазметку на шаге 3, иначе проверять для них нечего."

