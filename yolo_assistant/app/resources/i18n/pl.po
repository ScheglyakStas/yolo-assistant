msgid_plural "{names} still need a description of what to find. Type it in the Prompt column."
msgstr[0] "Klasa {names} nie ma jeszcze opisu (promptu), czyli tego, czego szukać. Wpisz go w kolumnie „Czego szukać”."
msgstr[1] "Klasy {names} nie mają jeszcze opisów (promptów), czyli tego, czego szukać. Wpisz je w kolumnie „Czego szukać”."
msgstr[2] "Klasy {names} nie mają jeszcze opisów (promptów), czyli tego, czego szukać. Wpisz je w kolumnie „Czego szukać”."

#: yolo_assistant/app/core/autolabel.py:180
msgid "Every photo already has a label. Tick \"Label everything again\" to redo them, or carry on to Step 4."
msgstr "Każde zdjęcie ma już etykietę. Zaznacz „Etykietuj wszystko od nowa”, aby zrobić to jeszcze raz, albo przejdź do kroku 4."

#: yolo_assistant/app/core/autolabel.py:193 yolo_assistant/app/core/review.py:339 yolo_assistant/app/core/training.py:633 yolo_assistant/app/ui/steps/autolabel_step.py:95
msgid "No prepared dataset yet."
