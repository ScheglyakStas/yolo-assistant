msgid "nvidia-ml-py is not installed."
msgstr "Pakiet nvidia-ml-py nie jest zainstalowany."

#: yolo_assistant/app/core/env_probe.py:247
msgid "NVML query failed: {error}"
msgstr "Zapytanie NVML nie powiodło się: {error}"

#: yolo_assistant/app/core/env_probe.py:260
msgid "The driver is installed but reports no NVIDIA GPU."
msgstr "Sterownik jest zainstalowany, ale nie zgłasza żadnej karty graficznej NVIDIA."

#: yolo_assistant/app/core/env_probe.py:269
msgid "No usable NVIDIA driver was found ({detail})."
msgstr "Nie znaleziono działającego sterownika NVIDIA ({detail})."

#: yolo_assistant/app/core/env_probe.py:299
msgid "Windows long path support is turned off. Installing PyTorch creates files with very long names and the install may fail partway through. Enable it with the Group Policy setting \"Enable Win32 long paths\", or set LongPathsEnabled to 1 under HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\FileSystem."
msgstr "Obsługa długich ścieżek w Windows jest wyłączona. Instalacja PyTorch tworzy pliki o bardzo długich nazwach i może się nie powieść w trakcie. Włącz ją ustawieniem zasad grupy „Włącz długie ścieżki Win32” („Enable Win32 long paths”) albo ustaw LongPathsEnabled na 1 w kluczu HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\FileSystem."

#: yolo_assistant/app/core/env_probe.py:325
msgid "nvidia-smi could not be run: {error}"
msgstr "Nie udało się uruchomić nvidia-smi: {error}"

#: yolo_assistant/app/core/export.py:113
msgid "Full precision. The largest file and the slowest, and the only one that cannot cost any accuracy at all."
msgstr "Pełna precyzja. Największy plik i najwolniejsze działanie, ale jako jedyna w ogóle nie obniża dokładności."

#: yolo_assistant/app/core/export.py:121
msgid "Half precision. About half the size and usually faster on a GPU, for an accuracy difference most datasets cannot measure."
msgstr "Połowiczna precyzja. Mniej więcej o połowę mniejszy plik i zwykle szybsze działanie na GPU, przy różnicy w dokładności, której na większości zbiorów danych nie da się zmierzyć."

#: yolo_assistant/app/core/export.py:129
msgid "8-bit integers. The smallest and fastest, and the only precision an INT8 QAT model can be exported at."
msgstr "8-bitowe liczby całkowite. Najmniejszy i najszybszy wariant, a zarazem jedyna precyzja, w jakiej można wyeksportować model INT8 QAT."

#: yolo_assistant/app/core/export.py:200
msgid "Runs almost anywhere -- onnxruntime on CPU or GPU, and most other deployment stacks read it. Start here."
msgstr "Działa niemal wszędzie – onnxruntime na CPU lub GPU, a większość innych środowisk wdrożeniowych też go odczytuje. Zacznij od niego."

#: yolo_assistant/app/core/export.py:213
msgid "The fastest thing NVIDIA hardware can run, and the least portable: the file is built for one GPU model and driver and will not load on another."
msgstr "Najszybsze, co potrafi uruchomić sprzęt NVIDIA, i zarazem najmniej przenośne: plik jest budowany dla jednego modelu karty graficznej i jednego sterownika i nie wczyta się na innych."

#: yolo_assistant/app/core/export.py:226
msgid "Intel processors and their built-in graphics."
msgstr "Procesory Intel i ich zintegrowana grafika."

#: yolo_assistant/app/core/export.py:232
msgid "PyTorch without Python. A good fallback when nothing else loads."
msgstr "PyTorch bez Pythona. Dobre wyjście awaryjne, gdy nic innego się nie wczytuje."

#: yolo_assistant/app/core/export.py:240
msgid "Phones and small boards."
msgstr "Telefony i małe komputery jednopłytkowe."

#: yolo_assistant/app/core/export.py:248
msgid "ARM phones, where it is usually quicker than TensorFlow Lite."
msgstr "Telefony z procesorami ARM, na których zwykle działa szybciej niż TensorFlow Lite."

#: yolo_assistant/app/core/export.py:257
msgid "Apple devices, using the Neural Engine."
msgstr "Urządzenia Apple, z wykorzystaniem Neural Engine."

#: yolo_assistant/app/core/export.py:265
msgid "TensorFlow Serving, and the input to most TensorFlow tooling."
msgstr "TensorFlow Serving; to także format wejściowy większości narzędzi TensorFlow."

#: yolo_assistant/app/core/export.py:271
msgid "The older frozen-graph format, for stacks that still want one."
msgstr "Starszy format zamrożonego grafu, dla środowisk, które wciąż go wymagają."

#: yolo_assistant/app/core/export.py:367
msgid "\"{item}\" is not a setting. Each one is a name, an equals sign and a value, like \"dynamic=true\"."
msgstr "„{item}” nie jest ustawieniem. Każde ustawienie to nazwa, znak równości i wartość, np. „dynamic=true”."

#: yolo_assistant/app/core/export.py:379 yolo_assistant/app/core/training.py:264
msgid "\"{item}\" has no setting name in front of the equals sign."
msgstr "„{item}” nie ma nazwy ustawienia przed znakiem równości."

#: yolo_assistant/app/core/export.py:383 yolo_assistant/app/core/training.py:268
msgid "\"{key}\" is not a valid setting name."
msgstr "„{key}” nie jest prawidłową nazwą ustawienia."

#: yolo_assistant/app/core/export.py:387
msgid "\"{key}\" is set by the app and cannot be changed here -- it decides what is exported, in what format and at what precision."
msgstr "„{key}” ustawia aplikacja i nie można go tu zmienić – to ustawienie decyduje o tym, co jest eksportowane, w jakim formacie i z jaką precyzją."

#: yolo_assistant/app/core/export.py:396
msgid "\"{key}\" is already set by the DeepStream toggle. Turn the toggle off if you want to set it yourself."
msgstr "„{key}” jest już ustawiane przez przełącznik DeepStream. Wyłącz przełącznik, jeśli chcesz ustawić tę wartość samodzielnie."

#: yolo_assistant/app/core/export.py:404 yolo_assistant/app/core/training.py:280
msgid "\"{key}\" is given twice. Keep only one of them."
msgstr "„{key}” podano dwukrotnie. Zostaw tylko jedno."

#: yolo_assistant/app/core/export.py:478
msgid "{run} - best epoch, mAP50-95 {fitness:.4f}"
msgstr "{run} - najlepsza epoka, mAP50-95 {fitness:.4f}"

#: yolo_assistant/app/core/export.py:484
msgid "{run} - best epoch"
msgstr "{run} - najlepsza epoka"

#: yolo_assistant/app/core/export.py:486
msgid "{run} - last epoch of {epochs}"
msgstr "{run} - ostatnia epoka (z {epochs})"

#: yolo_assistant/app/core/export.py:488
msgid "{run} - last epoch"
msgstr "{run} - ostatnia epoka"

#: yolo_assistant/app/core/export.py:666 yolo_assistant/app/core/export.py:664 worker/commands/export.py:500 worker/commands/export.py:498
msgid "{size:.1f} {unit}"
msgstr "{size:.1f} {unit}"

#: yolo_assistant/app/core/export.py:759
msgid "There is no trained model in this project yet. Train one in Step 5, or copy a run into the project's runs folder."
msgstr "W tym projekcie nie ma jeszcze wytrenowanego modelu. Wytrenuj go w kroku 5 albo skopiuj przebieg treningu do folderu runs projektu."

#: yolo_assistant/app/core/export.py:770
msgid "Choose a format to export to."
msgstr "Wybierz format eksportu."

#: yolo_assistant/app/core/export.py:772
msgid "Choose a precision to export at."
msgstr "Wybierz precyzję eksportu."

#: yolo_assistant/app/core/export.py:806
msgid "{format} cannot be exported at {precision}. It supports {supported}."
msgstr "Do formatu {format} nie można eksportować w precyzji {precision}. Obsługiwane są: {supported}."

#: yolo_assistant/app/core/export.py:822
msgid "\"{run}\" was trained for INT8, so its quantisers are already part of the model. Choose INT8; exporting it at {precision} throws the training away and usually fails outright."
msgstr "Przebieg „{run}” był trenowany pod INT8, więc jego kwantyzatory są już częścią modelu. Wybierz INT8; eksport w precyzji {precision} marnuje ten trening i zwykle od razu kończy się niepowodzeniem."

#: yolo_assistant/app/core/export.py:833
msgid "{format} cannot carry an INT8 QAT model's quantisers. Export it as {formats}."
msgstr "Format {format} nie przenosi kwantyzatorów modelu INT8 QAT. Wyeksportuj model jako {formats}."

#: yolo_assistant/app/core/export.py:851
msgid "\"{name}\" already exists and will be replaced. Nothing else in the exports folder is touched."
msgstr "Eksport „{name}” już istnieje i zostanie zastąpiony. Nic innego w folderze exports nie zostanie zmienione."

#: yolo_assistant/app/core/export.py:860
msgid "A TensorRT engine is built for this exact GPU and driver. Copying it to another machine will not work -- export there instead."
msgstr "Silnik TensorRT jest budowany dla tej konkretnej karty graficznej i tego sterownika. Skopiowanie go na inny komputer nie zadziała – wyeksportuj model tam."

#: yolo_assistant/app/core/export.py:868
msgid "The DeepStream settings only mean something to ONNX and TensorRT; {format} will ignore them."
msgstr "Ustawienia DeepStream mają znaczenie tylko dla ONNX i TensorRT; {format} je zignoruje."

#: yolo_assistant/app/core/export.py:877
msgid "\"{key}\" is not a setting this version of the app knows about. If your Ultralytics does not know it either, the export will refuse it before it starts."
msgstr "Ta wersja aplikacji nie zna ustawienia „{key}”. Jeśli twoja wersja Ultralytics też go nie zna, eksport odrzuci je, zanim się rozpocznie."

#: yolo_assistant/app/core/export.py:894
msgid "Nothing to export yet."
msgstr "Na razie nie ma czego eksportować."

#: yolo_assistant/app/core/export.py:896
msgid "{checkpoint} -- choose a format."
msgstr "{checkpoint} – wybierz format."

#: yolo_assistant/app/core/export.py:899
msgid "{run} ({which}) to {format}, {precision}, {width}x{height} -> {output}"
msgstr "{run} ({which}) do {format}, {precision}, {width}x{height} -> {output}"

#: yolo_assistant/app/core/export.py:960
msgid "Height has to be between {low} and {high} pixels."
msgstr "Wysokość musi wynosić od {low} do {high} pikseli."

#: yolo_assistant/app/core/export.py:961
msgid "Height has to be a multiple of {stride}. {value} is not -- the nearest that is, is {nearest}."
msgstr "Wysokość musi być wielokrotnością {stride}. {value} nią nie jest – najbliższa taka wartość to {nearest}."

#: yolo_assistant/app/core/export.py:965
msgid "\"{run}\" was trained at {trained} pixels, so the height can be at most {trained}; {value} would only make it slower."
msgstr "„{run}” trenowano w rozmiarze {trained} pikseli, więc wysokość może wynosić najwyżej {trained}; {value} tylko spowolniłoby model."

#: yolo_assistant/app/core/export.py:971
msgid "Width has to be between {low} and {high} pixels."
msgstr "Szerokość musi wynosić od {low} do {high} pikseli."

#: yolo_assistant/app/core/export.py:972
msgid "Width has to be a multiple of {stride}. {value} is not -- the nearest that is, is {nearest}."
msgstr "Szerokość musi być wielokrotnością {stride}. {value} nią nie jest – najbliższa taka wartość to {nearest}."

#: yolo_assistant/app/core/export.py:976
msgid "\"{run}\" was trained at {trained} pixels, so the width can be at most {trained}; {value} would only make it slower."
msgstr "„{run}” trenowano w rozmiarze {trained} pikseli, więc szerokość może wynosić najwyżej {trained}; {value} tylko spowolniłoby model."

#: yolo_assistant/app/core/export.py:987
msgid "{names} or {last}"
msgstr "{names} lub {last}"

#: yolo_assistant/app/core/inference.py:105
msgid "The NVIDIA card in this machine. Usually five to twenty times faster, and what a TensorRT engine requires."
msgstr "Karta NVIDIA w tym komputerze. Zwykle od pięciu do dwudziestu razy szybsza; wymaga jej silnik TensorRT."

#: yolo_assistant/app/core/inference.py:113
msgid "The processor. Slower, and the honest figure for a deployment machine with no graphics card."
msgstr "Procesor. Wolniejszy, ale daje rzetelny wynik dla komputera docelowego bez karty graficznej."

#: yolo_assistant/app/core/inference.py:165
msgid "Runs on both, and is the format to test first when anything else misbehaves."
msgstr "Działa na obu i to od tego formatu warto zacząć, gdy coś innego sprawia problemy."

#: yolo_assistant/app/core/inference.py:170
msgid "Compiled for the exact GPU and driver that built it. There is no CPU version of a TensorRT engine."
msgstr "Skompilowany dla konkretnego GPU i sterownika, na których powstał. Silnik TensorRT nie ma wersji na procesor (CPU)."

#: yolo_assistant/app/core/inference.py:177
msgid "PyTorch itself runs it, so it works wherever this app does."
msgstr "Uruchamia go sam PyTorch, więc działa wszędzie tam, gdzie ta aplikacja."

#: yolo_assistant/app/core/inference.py:183
msgid "Intel's runtime. Its own 'GPU' means Intel integrated graphics, not the NVIDIA card this app's GPU button refers to, so it is tested on the CPU here."
msgstr "Środowisko uruchomieniowe Intela. Jego „GPU” oznacza zintegrowaną grafikę Intela, a nie kartę NVIDIA, do której odnosi się przycisk GPU w tej aplikacji, dlatego jest tu testowany na procesorze (CPU)."

#: yolo_assistant/app/core/inference.py:192
msgid "Built for phones and small boards. On a desktop it needs TensorFlow to run."
msgstr "Przeznaczony dla telefonów i małych płytek. Na komputerze stacjonarnym do działania potrzebuje TensorFlow."

#: yolo_assistant/app/core/inference.py:198 yolo_assistant/app/core/inference.py:204
msgid "Needs TensorFlow, which this app does not install."
msgstr "Wymaga TensorFlow, którego ta aplikacja nie instaluje."

#: yolo_assistant/app/core/inference.py:210
msgid "Built for ARM phones. Running it here needs the ncnn package."
msgstr "Przeznaczony dla telefonów z procesorami ARM. Aby uruchomić go tutaj, potrzebny jest pakiet ncnn."

#: yolo_assistant/app/core/inference.py:216
msgid "Apple's format. It can only be run on an Apple device."
msgstr "Format firmy Apple. Można go uruchomić tylko na urządzeniu Apple."

#: yolo_assistant/app/core/inference.py:248
msgid "Photo"
msgstr "Zdjęcie"

#: yolo_assistant/app/core/inference.py:249
msgid "One still image, run once. The quickest way to find out whether the exported file works at all."
msgstr "Jedno zdjęcie, przetworzone raz. Najszybszy sposób, by sprawdzić, czy wyeksportowany plik w ogóle działa."

#: yolo_assistant/app/core/inference.py:256
msgid "Video"
msgstr "Wideo"

#: yolo_assistant/app/core/inference.py:257
msgid "A video file, frame by frame. The boxes are drawn onto a temporary copy of it, which plays at the video's own speed once every frame has been run."
msgstr "Plik wideo, klatka po klatce. Ramki są rysowane na tymczasowej kopii filmu, która po przetworzeniu wszystkich klatek jest odtwarzana z oryginalną szybkością."

#: yolo_assistant/app/core/inference.py:264
msgid "Camera"
msgstr "Kamera"

#: yolo_assistant/app/core/inference.py:265
msgid "A camera attached to this machine, live, until you stop it."
msgstr "Kamera podłączona do tego komputera, na żywo, dopóki jej nie zatrzymasz."

#: yolo_assistant/app/core/inference.py:292
msgid "Videos ({patterns});;All files (*)"
msgstr "Pliki wideo ({patterns});;Wszystkie pliki (*)"

#: yolo_assistant/app/core/inference.py:294
msgid "Photos ({patterns});;All files (*)"
msgstr "Zdjęcia ({patterns});;Wszystkie pliki (*)"

#: yolo_assistant/app/core/inference.py:320 worker/commands/cameras.py:147
msgid "Camera {index}"
msgstr "Kamera {index}"

#: yolo_assistant/app/core/inference.py:358
msgid "As the camera runs"
msgstr "Tak, jak działa kamera"

#: yolo_assistant/app/core/inference.py:493
msgid "There is nothing to test yet. Export a model in Step 6, or copy an exported file into the project's exports folder."
msgstr "Na razie nie ma czego testować. Wyeksportuj model w kroku 6 albo skopiuj wyeksportowany plik do folderu exports projektu."

#: yolo_assistant/app/core/inference.py:505
msgid "Choose what to test the model on."
msgstr "Wybierz, na czym przetestować model."

#: yolo_assistant/app/core/inference.py:510
msgid "No camera was found. Connect one and press Refresh; a camera another application already has open cannot be used here."
msgstr "Nie znaleziono żadnej kamery. Podłącz kamerę i naciśnij Odśwież; kamery, którą ma już otwartą inna aplikacja, nie można tu użyć."

#: yolo_assistant/app/core/inference.py:518
msgid "The confidence threshold has to be between {low:g} and {high:g}."
msgstr "Próg pewności musi wynosić od {low:g} do {high:g}."

#: yolo_assistant/app/core/inference.py:541
msgid "{format} cannot run on the {device}. It runs on: {devices}."
msgstr "{format} nie może działać na {device}. Działa na: {devices}."

#: yolo_assistant/app/core/inference.py:555
msgid "Choose a video to run the model on."
msgstr "Wybierz film do przetestowania modelu."

#: yolo_assistant/app/core/inference.py:556
msgid "Choose a photo to run the model on."
msgstr "Wybierz zdjęcie do przetestowania modelu."

#: yolo_assistant/app/core/inference.py:559
msgid "{path} is not there any more. Choose another video."
msgstr "Pliku {path} już nie ma. Wybierz inny film."

#: yolo_assistant/app/core/inference.py:560
msgid "{path} is not there any more. Choose another photo."
msgstr "Pliku {path} już nie ma. Wybierz inne zdjęcie."

#: yolo_assistant/app/core/inference.py:563
msgid "{name} is a folder. Choose a single video file."
msgstr "{name} to folder. Wybierz pojedynczy plik wideo."

#: yolo_assistant/app/core/inference.py:564
msgid "{name} is a folder. Choose a single photo file."
msgstr "{name} to folder. Wybierz pojedynczy plik zdjęcia."

#: yolo_assistant/app/core/inference.py:569
msgid "\"{name}\" is not a video this app recognises. Expected one of: {expected}."
msgstr "„{name}” nie jest filmem rozpoznawanym przez tę aplikację. Oczekiwano jednego z: {expected}."

#: yolo_assistant/app/core/inference.py:577
msgid "\"{name}\" is not a photo this app recognises. Expected one of: {expected}."
msgstr "„{name}” nie jest zdjęciem rozpoznawanym przez tę aplikację. Oczekiwano jednego z: {expected}."

#: yolo_assistant/app/core/inference.py:595 worker/commands/infer.py:1314
msgid "\"{package}\""
msgstr "„{package}”"

#: yolo_assistant/app/core/inference.py:600
msgid "Running {format} needs {packages}, which this app does not install. If the test fails to start, that is this machine rather than your model."
msgstr "Uruchomienie formatu {format} wymaga oprogramowania, którego ta aplikacja nie instaluje: {packages}. Jeśli test się nie uruchomi, przyczyna leży w tym komputerze, a nie w modelu."

#: yolo_assistant/app/core/inference.py:610
msgid "A TensorRT engine only runs on the GPU and driver that built it. If this one was exported elsewhere, it will not load."
