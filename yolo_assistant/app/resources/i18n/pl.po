#: worker/__main__.py:75
msgid "Reduce the batch size or image size, or close other GPU applications."
msgstr "Zmniejsz rozmiar partii (batch) lub rozmiar obrazu albo zamknij inne aplikacje korzystające z GPU."

#: worker/__main__.py:80
msgid "The installed PyTorch build does not support this GPU. Re-run environment setup and pick a newer CUDA backend."
msgstr "Zainstalowana wersja PyTorch nie obsługuje tej karty graficznej. Uruchom ponownie konfigurację środowiska i wybierz nowszą wersję (build) CUDA."

#: worker/__main__.py:91
msgid "a package this step needs"
msgstr "pakietu potrzebnego w tym kroku"

#: worker/__main__.py:94
msgid "The managed environment is missing {what}. Open Step 1 and press Repair: it installs what is missing without downloading everything again."
msgstr "W zarządzanym środowisku brakuje {what}. Otwórz krok 1 i kliknij Napraw: zostanie doinstalowane to, czego brakuje, bez ponownego pobierania wszystkiego."

#: worker/__main__.py:128
msgid "Cancelled by user."
msgstr "Anulowano na żądanie użytkownika."

#: worker/channel.py:91
msgid "IPC socket unavailable ({error}); using stdout framing"
msgstr "Gniazdo IPC jest niedostępne ({error}); komunikacja przez stdout"

#: worker/channel.py:248
msgid "The live picture needs the loopback control socket, which could not be opened, so only the numbers are shown. Everything else in this step works."
msgstr "Podgląd na żywo wymaga lokalnego gniazda sterującego (loopback), którego nie udało się otworzyć, więc wyświetlane są tylko liczby. Wszystko inne w tym kroku działa."

#: worker/commands/autolabel.py:139
msgid "{dataset} does not hold a prepared dataset. Run Step 2 again."
msgstr "{dataset} nie zawiera przygotowanego zbioru danych. Wykonaj ponownie krok 2."

#: worker/commands/autolabel.py:143
msgid "The confidence threshold must be between 0 and 1, not {threshold}."
msgstr "Próg pewności musi mieścić się między 0 a 1, a wynosi {threshold}."

#: worker/commands/autolabel.py:157
msgid "Every photo already has a label; there is nothing to do."
msgstr "Każde zdjęcie ma już etykietę; nie ma nic do zrobienia."

#: worker/commands/autolabel.py:163
msgid "No description was given for {names}. Each class needs a sentence saying what to look for."
msgstr "Nie podano opisu dla {names}. Każda klasa potrzebuje zdania opisującego, czego szukać."

#: worker/commands/autolabel.py:190
msgid "Loading {model}. The first run downloads it, which can take a few minutes."
msgstr "Wczytywanie modelu {model}. Przy pierwszym uruchomieniu model jest pobierany, co może potrwać kilka minut."

#: worker/commands/autolabel.py:211
msgid "Labelling {todo:,} photos in {classes} classes."
msgstr "Etykietowanie zdjęć: {todo:,}, liczba klas: {classes}."

#: worker/commands/autolabel.py:288
msgid "{name}: {labelled:,} photos labelled, {boxes:,} boxes, {empty:,} with nothing found."
msgstr "{name}: zdjęcia z nowymi etykietami: {labelled:,}, ramki: {boxes:,}, zdjęcia bez znalezionych obiektów: {empty:,}."

#: worker/commands/autolabel.py:322
msgid "Labelled {labelled:,} photos with {boxes:,} boxes in {seconds:.1f}s."
msgstr "Gotowe w {seconds:.1f} s. Zdjęcia z nowymi etykietami: {labelled:,}, ramki: {boxes:,}."

#: worker/commands/autolabel.py:357
msgid "{path} is empty. Run Step 2 again."
msgstr "Plik {path} jest pusty. Wykonaj ponownie krok 2."

#: worker/commands/autolabel.py:377
msgid "The dataset has no class named \"{name}\". It was prepared with a different set of classes -- go back to Step 2 and prepare it again."
msgstr "Zbiór danych nie ma klasy o nazwie „{name}”. Został przygotowany z innym zestawem klas – wróć do kroku 2 i przygotuj go ponownie."

#: worker/commands/autolabel.py:559
msgid "Ran out of GPU memory on {count} photos at once; continuing {half} at a time."
msgstr "Zabrakło pamięci GPU przy {count} zdjęciach naraz; dalej zdjęcia będą przetwarzane po {half} naraz."

#: worker/commands/autolabel.py:621
msgid "The managed environment cannot load OWLv2: {error}"
msgstr "Zarządzane środowisko nie może wczytać OWLv2: {error}"

#: worker/commands/autolabel.py:635
msgid "{model} could not be downloaded: {error}"
msgstr "Nie udało się pobrać modelu {model}: {error}"

#: worker/commands/autolabel.py:689
msgid "No working image processor could be loaded for {model}."
msgstr "Nie udało się wczytać działającego procesora obrazów (image processor) dla modelu {model}."

#: worker/commands/autolabel.py:704
msgid "defaults"
msgstr "domyślne"

#: worker/commands/autolabel.py:706
msgid "Preparing photos with {name} ({options}): {cost:.0f} ms per {n} photos, against {slowest:.0f} ms the slowest way of asking."
msgid_plural "Preparing photos with {name} ({options}): {cost:.0f} ms per {n} photos, against {slowest:.0f} ms the slowest way of asking."
msgstr[0] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęcie, wobec {slowest:.0f} ms przy najwolniejszym wariancie wywołania."
msgstr[1] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęcia, wobec {slowest:.0f} ms przy najwolniejszym wariancie wywołania."
msgstr[2] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęć, wobec {slowest:.0f} ms przy najwolniejszym wariancie wywołania."

#: worker/commands/autolabel.py:716
msgid "Preparing photos with {name} ({options}): {cost:.0f} ms per {n} photos. This transformers offers no faster path for OWLv2."
msgid_plural "Preparing photos with {name} ({options}): {cost:.0f} ms per {n} photos. This transformers offers no faster path for OWLv2."
msgstr[0] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęcie. Ta wersja transformers nie oferuje szybszej ścieżki dla OWLv2."
msgstr[1] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęcia. Ta wersja transformers nie oferuje szybszej ścieżki dla OWLv2."
msgstr[2] "Przygotowywanie zdjęć za pomocą {name} ({options}): {cost:.0f} ms na {n} zdjęć. Ta wersja transformers nie oferuje szybszej ścieżki dla OWLv2."

#: worker/commands/autolabel.py:795
msgid "PyTorch cannot see the GPU, so autolabeling would take days instead of minutes."
msgstr "PyTorch nie widzi karty graficznej (GPU), więc automatyczne etykietowanie trwałoby dni zamiast minut."

#: worker/commands/autolabel.py:819
msgid "Running on {name}: {free:.1f} GB of {total:.1f} GB free, weights in {precision}."
msgstr "Obliczenia na karcie {name}: wolne {free:.1f} GB z {total:.1f} GB, wagi w precyzji {precision}."

#: worker/commands/autolabel.py:827
msgid "Running on the CPU in {precision}. This will be slow."
msgstr "Obliczenia na procesorze (CPU), precyzja {precision}. To potrwa długo."

#: worker/commands/autolabel.py:851
msgid "Running on the CPU, so one photo at a time."
msgstr "Obliczenia na procesorze (CPU), więc po jednym zdjęciu naraz."

#: worker/commands/autolabel.py:863
msgid "{per_photo:.1f} GB of GPU memory per photo, {free:.1f} GB free: labelling {batch} at a time."
msgstr "{per_photo:.1f} GB pamięci GPU na zdjęcie, wolne {free:.1f} GB: etykietowanie po {batch} naraz."

#: worker/commands/autolabel.py:971
msgid "\"{name}\": nothing was found in {empty:,} of {n:,} photos. Those are now labelled as containing no objects. If that is wrong, try describing the object differently or lowering the confidence threshold."
msgid_plural "\"{name}\": nothing was found in {empty:,} of {n:,} photos. Those are now labelled as containing no objects. If that is wrong, try describing the object differently or lowering the confidence threshold."
msgstr[0] "„{name}”: na {empty:,} z {n:,} zdjęcia nic nie znaleziono. Te zdjęcia mają teraz etykiety oznaczające brak obiektów. Jeśli to błąd, spróbuj opisać obiekt inaczej albo obniżyć próg pewności."
msgstr[1] "„{name}”: na {empty:,} z {n:,} zdjęć nic nie znaleziono. Te zdjęcia mają teraz etykiety oznaczające brak obiektów. Jeśli to błąd, spróbuj opisać obiekt inaczej albo obniżyć próg pewności."
msgstr[2] "„{name}”: na {empty:,} z {n:,} zdjęć nic nie znaleziono. Te zdjęcia mają teraz etykiety oznaczające brak obiektów. Jeśli to błąd, spróbuj opisać obiekt inaczej albo obniżyć próg pewności."

#: worker/commands/autolabel.py:987
msgid "Not a single box was found. The descriptions probably do not match what is in the photos, or the threshold is too high."
msgstr "Nie znaleziono ani jednej ramki. Opisy prawdopodobnie nie pasują do tego, co jest na zdjęciach, albo próg jest zbyt wysoki."

#: worker/commands/cameras.py:73
msgid "Camera {index}: {name} ({width}x{height}, {fps} frames a second)."
msgstr "Kamera {index}: {name} ({width}x{height}, {fps} kl./s)."

#: worker/commands/cameras.py:79
msgid "Camera {index}: {name} ({width}x{height})."
msgstr "Kamera {index}: {name} ({width}x{height})."

#: worker/commands/cameras.py:84
msgid "No camera answered. One that another application already has open cannot be opened again here."
msgstr "Żadna kamera nie odpowiedziała. Kamery, którą ma już otwartą inna aplikacja, nie można tu otworzyć ponownie."

#: worker/commands/export.py:82
msgid "Height has to be a multiple of 32; {value} is not. YOLO lays its detections out on a grid of that spacing."
msgstr "Wysokość musi być wielokrotnością 32; {value} nią nie jest. YOLO rozmieszcza swoje wykrycia na siatce o takim rozstawie."

#: worker/commands/export.py:86
msgid "Width has to be a multiple of 32; {value} is not. YOLO lays its detections out on a grid of that spacing."
msgstr "Szerokość musi być wielokrotnością 32; {value} nią nie jest. YOLO rozmieszcza swoje wykrycia na siatce o takim rozstawie."

#: worker/commands/export.py:110
msgid "{weights} is not there."
msgstr "Nie ma pliku {weights}."

#: worker/commands/export.py:111
msgid "The run it belongs to has been deleted or renamed. Go back to Step 6 and pick a checkpoint that is still on disk."
msgstr "Przebieg treningu, do którego należy, został usunięty lub ma zmienioną nazwę. Wróć do kroku 6 i wybierz punkt kontrolny, który nadal jest na dysku."

#: worker/commands/export.py:120
msgid "The nearest size that works is {nearest}."
msgstr "Najbliższy rozmiar, który zadziała, to {nearest}."

#: worker/commands/export.py:141
msgid "Exporting {weights} to {format} at {precision}, {width}x{height}, on device {device}."
msgstr "Eksportowanie {weights} do {format} w precyzji {precision}, {width}x{height}, na urządzeniu {device}."

#: worker/commands/export.py:153
msgid "Graph simplification is on and the ONNX opset is 19."
msgstr "Upraszczanie grafu jest włączone, a opset ONNX to 19."

#: worker/commands/export.py:159
msgid "Converting. There is no progress to report from inside an export -- a TensorRT engine build in particular is several quiet minutes."
msgstr "Konwertowanie. Z wnętrza eksportu nie da się raportować postępu – zwłaszcza budowanie silnika TensorRT to kilka minut ciszy."

#: worker/commands/export.py:196
msgid "{name} is only {kilobytes:.0f} KB, which is small for a detector. Test it in Step 7 before deploying it."
msgstr "{name} ma tylko {kilobytes:.0f} KB, co jest mało jak na detektor. Przetestuj go w kroku 7, zanim go wdrożysz."

#: worker/commands/export.py:207
msgid "Wrote {path} ({size}) in {duration}."
msgstr "Zapisano {path} ({size}) w czasie {duration}."

#: worker/commands/export.py:288
msgid "Ultralytics has no export setting called {names}. Check the spelling in the additional settings box."
msgstr "Ultralytics nie ma ustawienia eksportu o nazwie {names}. Sprawdź pisownię w polu dodatkowych ustawień."

#: worker/commands/export.py:293 worker/commands/train.py:420
msgid "The full list of settings is at https://docs.ultralytics.com/usage/cfg/"
msgstr "Pełna lista ustawień jest pod adresem https://docs.ultralytics.com/usage/cfg/"

#: worker/commands/export.py:298
msgid "This Ultralytics has no {names}, so the DeepStream toggle could not set it. The export itself is unaffected."
msgid_plural "This Ultralytics has no {names}, so the DeepStream toggle could not set them. The export itself is unaffected."
msgstr[0] "Ta wersja Ultralytics nie ma ustawienia {names}, więc przełącznik DeepStream nie mógł go ustawić. Nie wpływa to na sam eksport."
msgstr[1] "Ta wersja Ultralytics nie ma ustawień {names}, więc przełącznik DeepStream nie mógł ich ustawić. Nie wpływa to na sam eksport."
msgstr[2] "Ta wersja Ultralytics nie ma ustawień {names}, więc przełącznik DeepStream nie mógł ich ustawić. Nie wpływa to na sam eksport."

#: worker/commands/export.py:306
msgid "The exported file may still work in DeepStream. If it does not, report this: the app's DeepStream settings need updating for this Ultralytics release."
msgstr "Wyeksportowany plik może mimo to działać w DeepStream. Jeśli nie działa, zgłoś to: ustawienia DeepStream w aplikacji wymagają aktualizacji dla tej wersji Ultralytics."

#: worker/commands/export.py:343
msgid "A TensorRT engine is compiled for the GPU in this machine, and PyTorch cannot see one. Export to ONNX instead, which runs anywhere, or build the engine on the machine it will run on."
msgstr "Silnik TensorRT jest kompilowany dla karty graficznej w tym komputerze, a PyTorch żadnej nie widzi. Zamiast tego wyeksportuj model do ONNX, który działa wszędzie, albo zbuduj silnik na komputerze, na którym będzie używany."

#: worker/commands/export.py:370
msgid "The export finished but did not leave a file behind -- it reported {produced}. Look in {folder} for a partial one."
msgstr "Eksport się zakończył, ale nie pozostawił pliku – zgłosił {produced}. Poszukaj niepełnego pliku w {folder}."

#: worker/commands/export.py:378
msgid "The export finished but did not leave a file behind. Look in {folder} for a partial one."
msgstr "Eksport się zakończył, ale nie pozostawił pliku. Poszukaj niepełnego pliku w {folder}."

#: worker/commands/export.py:405
msgid "{name} could not be moved into {folder}: {error}. Close anything that has the previous export of this name open."
msgstr "Nie udało się przenieść {name} do {folder}: {error}. Zamknij wszystko, co ma otwarty poprzedni eksport o tej nazwie."

#: worker/commands/export.py:426
msgid "This model was trained for INT8, and exporting it at {precision} failed: {error}"
msgstr "Ten model był trenowany pod INT8, a eksport w precyzji {precision} nie powiódł się: {error}"

#: worker/commands/export.py:435
msgid "This model was trained for INT8, and {format} cannot carry its quantisers: {error}"
msgstr "Ten model był trenowany pod INT8, a format {format} nie przenosi jego kwantyzatorów: {error}"

#: worker/commands/export.py:441
msgid "Export it as ONNX or TensorRT instead."
msgstr "Zamiast tego wyeksportuj go jako ONNX lub TensorRT."

#: worker/commands/export.py:462 worker/commands/train.py:862
msgid "{model} could not be loaded: {error}"
msgstr "Nie udało się wczytać {model}: {error}"

#: worker/commands/export.py:463
msgid "The file may be truncated or from an incompatible Ultralytics release. Train the model again in Step 5."
msgstr "Plik może być ucięty albo pochodzić z niezgodnej wersji Ultralytics. Wytrenuj model ponownie w kroku 5."

#: worker/commands/fake_train.py:64
msgid "Simulating {n} epochs x {batches} batches."
msgid_plural "Simulating {n} epochs x {batches} batches."
msgstr[0] "Symulacja: {n} epoka, partii na epokę: {batches}."
msgstr[1] "Symulacja: {n} epoki, partii na epokę: {batches}."
msgstr[2] "Symulacja: {n} epok, partii na epokę: {batches}."

#: worker/commands/fake_train.py:145
msgid "Finished {n} epochs in {seconds:.1f}s."
msgid_plural "Finished {n} epochs in {seconds:.1f}s."
msgstr[0] "Ukończono {n} epokę w {seconds:.1f} s."
msgstr[1] "Ukończono {n} epoki w {seconds:.1f} s."
msgstr[2] "Ukończono {n} epok w {seconds:.1f} s."

#: worker/commands/infer.py:177
msgid "{mode!r} is not something this app can test against."
msgstr "Ta aplikacja nie potrafi testować modelu na źródle {mode!r}."

#: worker/commands/infer.py:190
msgid "{path} is not there any more."
msgstr "Pliku {path} już nie ma."

#: worker/commands/infer.py:191
msgid "It has been deleted or renamed since this page listed it. Go back to Step 7 and pick another file, or export it again in Step 6."
msgstr "Plik został usunięty lub przemianowany, odkąd ta strona go wyświetliła. Wróć do kroku 7 i wybierz inny plik albo wyeksportuj go ponownie w kroku 6."

#: worker/commands/infer.py:217
msgid "Testing {model} on the GPU at confidence {conf:g}."
msgstr "Testowanie {model} na GPU przy progu pewności {conf:g}."

#: worker/commands/infer.py:225
msgid "Testing {model} on the processor at confidence {conf:g}."
msgstr "Testowanie {model} na procesorze przy progu pewności {conf:g}."

#: worker/commands/infer.py:275
msgid "Saved the photo, boxes drawn, to {path}."
msgstr "Zapisano zdjęcie z narysowanymi ramkami w pliku {path}."

#: worker/commands/infer.py:279
msgid "{name}: {n} object found in {ms:.1f} ms. Getting the model ready took {seconds:.1f} s, which is paid once rather than per frame."
msgid_plural "{name}: {n} objects found in {ms:.1f} ms. Getting the model ready took {seconds:.1f} s, which is paid once rather than per frame."
msgstr[0] "{name}: znaleziono {n} obiekt w {ms:.1f} ms. Przygotowanie modelu zajęło {seconds:.1f} s; ten czas jest potrzebny tylko raz, a nie dla każdej klatki."
msgstr[1] "{name}: znaleziono {n} obiekty w {ms:.1f} ms. Przygotowanie modelu zajęło {seconds:.1f} s; ten czas jest potrzebny tylko raz, a nie dla każdej klatki."
msgstr[2] "{name}: znaleziono {n} obiektów w {ms:.1f} ms. Przygotowanie modelu zajęło {seconds:.1f} s; ten czas jest potrzebny tylko raz, a nie dla każdej klatki."

#: worker/commands/infer.py:295
msgid "Nothing was found in this photo. That is a real answer if there is nothing there -- otherwise try a lower confidence threshold, or a photo more like the ones it was trained on."
msgstr "Na tym zdjęciu nic nie znaleziono. To prawdziwa odpowiedź, jeśli rzeczywiście nic na nim nie ma – w przeciwnym razie spróbuj niższego progu pewności albo zdjęcia bardziej podobnego do tych, na których model był trenowany."

#: worker/commands/infer.py:323
msgid "The photo with its boxes could not be saved: {error}"
msgstr "Nie udało się zapisać zdjęcia z ramkami: {error}"

#: worker/commands/infer.py:336
msgid "{name}: {n:,} frames."
msgid_plural "{name}: {n:,} frames."
msgstr[0] "{name}: {n:,} klatka."
msgstr[1] "{name}: {n:,} klatki."
msgstr[2] "{name}: {n:,} klatek."

#: worker/commands/infer.py:340
msgid "{name}: this file does not say how many frames it has, so there is no estimate of how long it will take."
msgstr "{name}: ten plik nie podaje liczby klatek, więc nie da się oszacować, ile to potrwa."

#: worker/commands/infer.py:347
msgid "Each frame is written, boxes drawn, to {output}. It plays at {fps:g} frames a second once every frame has been run."
msgstr "Każda klatka z narysowanymi ramkami jest zapisywana do pliku {output}. Po przetworzeniu wszystkich klatek zostanie on odtworzony z szybkością {fps:g} kl./s."

#: worker/commands/infer.py:365
msgid "Saved {n:,} annotated frames to {path}."
msgid_plural "Saved {n:,} annotated frames to {path}."
msgstr[0] "Zapisano {n:,} klatkę z ramkami w pliku {path}."
msgstr[1] "Zapisano {n:,} klatki z ramkami w pliku {path}."
msgstr[2] "Zapisano {n:,} klatek z ramkami w pliku {path}."

#: worker/commands/infer.py:394
msgid "Camera {index} is open at {mode}."
msgstr "Kamera {index} jest otwarta w trybie {mode}."

#: worker/commands/infer.py:401
msgid "That is the most this camera offers; {width}x{height} was asked for."
msgstr "To najwięcej, ile oferuje ta kamera; żądano {width}x{height}."

#: worker/commands/infer.py:410
msgid "This camera has no {width}x{height} mode, so it chose the nearest one it has."
msgstr "Ta kamera nie ma trybu {width}x{height}, więc wybrała najbliższy, jaki ma."

#: worker/commands/infer.py:427
msgid "The model is given at most {fps} frames a second; the camera's others are read and skipped, so the picture stays current."
msgstr "Model dostaje najwyżej {fps} kl./s; pozostałe klatki z kamery są odczytywane i pomijane, więc obraz pozostaje aktualny."

#: worker/commands/infer.py:433
msgid "It runs until you press Stop. Nothing is saved."
msgstr "Działa, dopóki nie naciśniesz Zatrzymaj. Nic nie jest zapisywane."

#: worker/commands/infer.py:440
msgid "The camera delivered {delivered:.1f} frames a second; {fps} were asked for."
msgstr "Kamera dostarczała {delivered:.1f} kl./s; żądano: {fps}."

#: worker/commands/infer.py:458
msgid "{fps} frames a second"
msgstr "{fps} kl./s"

#: worker/commands/infer.py:550
msgid "{fps:.1f} frames a second"
msgstr "{fps:.1f} klatki na sekundę"

#: worker/commands/infer.py:578
msgid "Stopped after {n:,} frames, {mean:.1f} ms a frame on average ({p95:.1f} ms at the slow end), {fps:.1f} frames a second end to end."
msgid_plural "Stopped after {n:,} frames, {mean:.1f} ms a frame on average ({p95:.1f} ms at the slow end), {fps:.1f} frames a second end to end."
msgstr[0] "Zatrzymano po {n:,} klatce, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."
msgstr[1] "Zatrzymano po {n:,} klatkach, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."
msgstr[2] "Zatrzymano po {n:,} klatkach, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."

#: worker/commands/infer.py:589
msgid "Finished: {n:,} frames, {mean:.1f} ms a frame on average ({p95:.1f} ms at the slow end), {fps:.1f} frames a second end to end."
msgid_plural "Finished: {n:,} frames, {mean:.1f} ms a frame on average ({p95:.1f} ms at the slow end), {fps:.1f} frames a second end to end."
msgstr[0] "Zakończono: {n:,} klatka, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."
msgstr[1] "Zakończono: {n:,} klatki, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."
msgstr[2] "Zakończono: {n:,} klatek, średnio {mean:.1f} ms na klatkę ({p95:.1f} ms w najwolniejszych przypadkach), {fps:.1f} klatki na sekundę w całym procesie."

#: worker/commands/infer.py:599
msgid "No frames were read."
msgstr "Nie odczytano żadnej klatki."

#: worker/commands/infer.py:634
msgid "The annotated video could not be saved: {error}"
msgstr "Nie udało się zapisać filmu z ramkami: {error}"

#: worker/commands/infer.py:702
msgid "Getting the model ready. The first frame through is much slower than the rest and is not counted."
msgstr "Przygotowywanie modelu. Pierwsza klatka jest przetwarzana znacznie wolniej niż kolejne i nie jest wliczana."

#: worker/commands/infer.py:730
msgid "The model was exported at {model_w}x{model_h}, but this input is {width}x{height} -- a different aspect ratio. Every frame is padded out to the model's shape and the padding is processed too, so inference is slower than it needs to be. Export again in Step 6 at a size with the input's shape for the best speed."
msgstr "Model wyeksportowano w rozmiarze {model_w}x{model_h}, a to wejście ma {width}x{height} – inne proporcje. Każda klatka jest uzupełniana marginesem do kształtu modelu, a margines też jest przetwarzany, więc wnioskowanie jest wolniejsze, niż mogłoby być. Aby uzyskać najlepszą szybkość, wyeksportuj model ponownie w kroku 6 w rozmiarze o proporcjach wejścia."

#: worker/commands/infer.py:784
msgid "The model returned nothing for this frame."
msgstr "Model nie zwrócił niczego dla tej klatki."

#: worker/commands/infer.py:874
msgid "{name} could not be read: {error}"
msgstr "Nie udało się odczytać pliku {name}: {error}"

#: worker/commands/infer.py:878
msgid "{name} opened but contains no image data."
msgstr "Plik {name} otwiera się, ale nie zawiera danych obrazu."

#: worker/commands/infer.py:890
msgid "The codec inside it may not be one this OpenCV build reads. An MP4 with H.264 video is the safest thing to test with."
msgstr "Kodek w tym pliku może nie być obsługiwany przez tę wersję OpenCV. Najbezpieczniej testować na pliku MP4 z obrazem H.264."

#: worker/commands/infer.py:895
msgid "The path also contains characters outside this system's default encoding, which some video backends cannot open; a folder with a plain ASCII name rules that out."
msgstr "Ścieżka zawiera też znaki spoza domyślnego kodowania tego systemu, których niektóre backendy wideo nie potrafią otworzyć; folder o nazwie złożonej tylko ze znaków ASCII wykluczy tę przyczynę."

#: worker/commands/infer.py:901
msgid "{name} could not be opened."
msgstr "Nie udało się otworzyć pliku {name}."

#: worker/commands/infer.py:933
msgid "Camera {index} could not be opened."
msgstr "Nie udało się otworzyć kamery {index}."

#: worker/commands/infer.py:1076
msgid "{folder} could not be created: {error}"
msgstr "Nie udało się utworzyć folderu {folder}: {error}"

#: worker/commands/infer.py:1081 worker/commands/infer.py:324
msgid "The project folder may be read-only or out of space."
msgstr "Folder projektu może być tylko do odczytu albo zabrakło na nim miejsca."

#: worker/commands/infer.py:1083
msgid "The project folder may be read-only or out of space, or its path contains characters this system's video backend cannot handle."
msgstr "Folder projektu może być tylko do odczytu, mogło zabraknąć na nim miejsca albo jego ścieżka zawiera znaki, których backend wideo tego systemu nie obsługuje."

#: worker/commands/infer.py:1088
msgid "{name} could not be opened for writing."
msgstr "Nie udało się otworzyć pliku {name} do zapisu."

#: worker/commands/infer.py:1108
msgid "OpenCV could not encode a {suffix} image"
msgstr "OpenCV nie potrafi zakodować obrazu {suffix}"

#: worker/commands/infer.py:1146
msgid "A frame could not be prepared for display."
msgstr "Nie udało się przygotować klatki do wyświetlenia."

#: worker/commands/infer.py:1182
msgid "The result could not be drawn: {error}"
msgstr "Nie udało się narysować wyniku: {error}"

#: worker/commands/infer.py:1220
msgid "class {index}"
msgstr "klasa {index}"

#: worker/commands/infer.py:1275
msgid "{camera!r} is not a camera."
msgstr "{camera!r} nie jest kamerą."

#: worker/commands/infer.py:1281
msgid "No video was chosen to run the model on."
msgstr "Nie wybrano filmu do przetestowania modelu."

#: worker/commands/infer.py:1283
msgid "No photo was chosen to run the model on."
msgstr "Nie wybrano zdjęcia do przetestowania modelu."

#: worker/commands/infer.py:1284
msgid "Pick a file in Step 7 and press Start again."
msgstr "Wybierz plik w kroku 7 i ponownie naciśnij Rozpocznij."

#: worker/commands/infer.py:1289
msgid "{path} is not there."
msgstr "Nie znaleziono pliku {path}."

#: worker/commands/infer.py:1290
msgid "It has been moved or deleted. Choose another file."
msgstr "Plik został przeniesiony lub usunięty. Wybierz inny plik."

#: worker/commands/infer.py:1316
msgid "Running a {format} file needs {packages}, which is not installed in this environment."
msgstr "Uruchomienie pliku {format} wymaga oprogramowania, którego brakuje w tym środowisku: {packages}."

#: worker/commands/infer.py:1323
msgid "Running a model in this file needs {packages}, which is not installed in this environment."
msgstr "Uruchomienie modelu z tego pliku wymaga oprogramowania, którego brakuje w tym środowisku: {packages}."

#: worker/commands/infer.py:1330
msgid "If this is ONNX or TensorRT, open Step 1 and press Repair. The other formats need runtimes this app does not install, so export the model to ONNX in Step 6 and test that instead."
msgstr "Jeśli to ONNX lub TensorRT, otwórz krok 1 i naciśnij Napraw. Pozostałe formaty wymagają środowisk uruchomieniowych, których ta aplikacja nie instaluje, więc wyeksportuj model do ONNX w kroku 6 i przetestuj ten plik."

#: worker/commands/infer.py:1349
msgid "A TensorRT engine is compiled machine code for a graphics card and has no processor version."
msgstr "Silnik TensorRT to skompilowany kod maszynowy dla karty graficznej i nie ma wersji na procesor."

#: worker/commands/infer.py:1353
msgid "Choose the GPU, or test an ONNX export to see CPU speeds."
msgstr "Wybierz GPU albo przetestuj eksport ONNX, aby zobaczyć szybkość na CPU."

#: worker/commands/infer.py:1360
msgid "PyTorch could not be imported: {error}"
msgstr "Nie udało się zaimportować PyTorch: {error}"

#: worker/commands/infer.py:1364
msgid "The GPU was chosen and PyTorch cannot see one."
msgstr "Wybrano GPU, ale PyTorch go nie widzi."

#: worker/commands/infer.py:1365
msgid "Choose CPU to test the model anyway, or go back to Step 1 and let the app set up its environment again."
msgstr "Wybierz CPU, aby mimo to przetestować model, albo wróć do kroku 1 i pozwól aplikacji ponownie skonfigurować środowisko."

#: worker/commands/infer.py:1391
msgid "onnxruntime has no CUDA provider in this environment, so this ONNX model runs on the processor even though the GPU was chosen. The timings below are processor timings."
msgstr "onnxruntime nie ma w tym środowisku dostawcy CUDA, więc ten model ONNX działa na procesorze, mimo że wybrano GPU. Poniższe czasy dotyczą procesora."

#: worker/commands/infer.py:1396
msgid "Open Step 1 and press Repair, which reinstalls onnxruntime-gpu. A TensorRT export in Step 6 is the faster answer on this machine."
msgstr "Otwórz krok 1 i naciśnij Napraw, co ponownie zainstaluje onnxruntime-gpu. Na tym komputerze szybszym rozwiązaniem jest eksport do TensorRT w kroku 6."

#: worker/commands/infer.py:1413
msgid "{name} could not be loaded: {error}"
msgstr "Nie udało się wczytać {name}: {error}"

#: worker/commands/infer.py:1414
msgid "It may be from an incompatible Ultralytics release, or -- if it is a TensorRT engine -- built on another machine. Export it again in Step 6."
msgstr "Może pochodzić z niezgodnej wersji Ultralytics albo – jeśli to silnik TensorRT – zostać zbudowany na innym komputerze. Wyeksportuj go ponownie w kroku 6."

#: worker/commands/infer.py:1427
msgid "The GPU ran out of memory: {error}"
msgstr "Zabrakło pamięci GPU: {error}"

#: worker/commands/infer.py:1428
msgid "Close anything else using the card, or test on the CPU. A model exported at a smaller image size also needs less."
msgstr "Zamknij inne programy korzystające z karty albo testuj na CPU. Model wyeksportowany z mniejszym rozmiarem obrazu również potrzebuje mniej pamięci."

#: worker/commands/infer.py:1435
msgid "This engine could not be loaded by the TensorRT on this machine: {error}"
msgstr "TensorRT na tym komputerze nie może wczytać tego silnika: {error}"

#: worker/commands/infer.py:1439
msgid "A TensorRT engine only works on the GPU and driver that built it. Export it again in Step 6, on this machine."
msgstr "Silnik TensorRT działa tylko na GPU i ze sterownikiem, na których został zbudowany. Wyeksportuj go ponownie w kroku 6, na tym komputerze."

#: worker/commands/prepare_dataset.py:88
msgid "No classes to prepare."
msgstr "Brak klas do przygotowania."

#: worker/commands/prepare_dataset.py:90
msgid "The photo folder {folder} is not there any more."
msgstr "Folder ze zdjęciami {folder} już nie istnieje."

#: worker/commands/prepare_dataset.py:93
msgid "The validation share must be between 0 and 1, not {value}."
msgstr "Udział zbioru walidacyjnego musi mieścić się między 0 a 1, a wynosi {value}."

#: worker/commands/prepare_dataset.py:107
msgid "No photos were found in {folder}. Supported types are {types}."
msgstr "W folderze {folder} nie znaleziono zdjęć. Obsługiwane typy to: {types}."

#: worker/commands/prepare_dataset.py:122
msgid "Preparing {n:,} photos from {source} into {project}."
msgid_plural "Preparing {n:,} photos from {source} into {project}."
msgstr[0] "Przygotowywanie {n:,} zdjęcia z {source} do {project}."
msgstr[1] "Przygotowywanie {n:,} zdjęć z {source} do {project}."
msgstr[2] "Przygotowywanie {n:,} zdjęć z {source} do {project}."

#: worker/commands/prepare_dataset.py:184
msgid "{name}: {n:,} photos."
msgid_plural "{name}: {n:,} photos."
msgstr[0] "{name}: {n:,} zdjęcie."
msgstr[1] "{name}: {n:,} zdjęcia."
msgstr[2] "{name}: {n:,} zdjęć."

#: worker/commands/prepare_dataset.py:190
msgid "Not one photo could be read. The files may be damaged, or they may be something other than photos with a photo's extension."
msgstr "Nie udało się odczytać ani jednego zdjęcia. Pliki mogą być uszkodzone albo mogą to być pliki innego rodzaju, które tylko mają rozszerzenie zdjęcia."

#: worker/commands/prepare_dataset.py:229
msgid "Prepared {photos:,} photos in {classes} classes ({train:,} for training, {val:,} held back) in {seconds:.1f}s."
msgstr "Gotowe w {seconds:.1f} s. Zdjęcia: {photos:,}, klasy: {classes} (do treningu: {train:,}, odłożone do sprawdzenia: {val:,})."

#: worker/commands/prepare_dataset.py:452
msgid "{path} cannot be used: {error}"
msgstr "Nie można użyć {path}: {error}"

#: worker/commands/prepare_dataset.py:455
msgid "The project folder cannot be inside the photo folder. Choose a folder next to it instead, so the originals stay untouched."
msgstr "Folder projektu nie może znajdować się wewnątrz folderu ze zdjęciami. Wybierz zamiast tego folder obok niego, aby oryginały pozostały nienaruszone."

#: worker/commands/prepare_dataset.py:488
msgid "Skipped {name}: it could not be read ({error})."
msgstr "Pominięto {name}: nie udało się go odczytać ({error})."

#: worker/commands/prepare_dataset.py:496
msgid "Skipped {name}: identical to {first}. The same photo in two classes teaches the model two different answers to the same question."
msgstr "Pominięto {name}: jest identyczny z {first}. To samo zdjęcie w dwóch klasach uczy model dwóch różnych odpowiedzi na to samo pytanie."

#: worker/commands/prepare_dataset.py:508
msgid "Repaired {name}: it was incomplete and has been re-saved."
msgstr "Naprawiono {name}: plik był niekompletny i został zapisany ponownie."

#: worker/commands/prepare_dataset.py:515
msgid "{name} is only {width}x{height} pixels."
msgstr "{name} ma tylko {width}x{height} px."

#: worker/commands/prepare_dataset.py:528
msgid "Further problems will be counted but not listed."
msgstr "Kolejne problemy będą liczone, ale nie wymieniane."

#: worker/commands/probe.py:62
msgid "{name} cannot be imported in this environment."
msgstr "Nie można zaimportować {name} w tym środowisku."

#: worker/commands/train.py:86
msgid "The image size has to be a multiple of 32; {imgsz} is not. YOLO lays its detections out on a grid of that spacing."
msgstr "Rozmiar obrazu musi być wielokrotnością 32; {imgsz} nie jest. YOLO rozmieszcza wykrycia na siatce o takim odstępie."

#: worker/commands/train.py:132
msgid "Training may use up to {gb:.1f} GB of GPU memory. If a batch needs more, the batch size is halved rather than letting Windows move the overflow into much slower system memory."
msgstr "Trening może użyć do {gb:.1f} GB pamięci GPU. Jeśli partia potrzebuje więcej, jej rozmiar zostanie zmniejszony o połowę, zamiast pozwolić systemowi Windows przenieść nadmiar do znacznie wolniejszej pamięci systemowej."

#: worker/commands/train.py:141
msgid "Loading {model}. The first run downloads it, which takes a moment."
msgstr "Wczytywanie {model}. Przy pierwszym użyciu model jest pobierany, co chwilę potrwa."

#: worker/commands/train.py:168
msgid "INT8 QAT: Ultralytics calibrates the quantisers on a few training batches before the first epoch. Export the result as INT8 in Step 6."
msgstr "INT8 QAT: przed pierwszą epoką Ultralytics kalibruje kwantyzatory na kilku partiach treningowych. Wyeksportuj wynik jako INT8 w kroku 6."

#: worker/commands/train.py:180
msgid "Training {model} for {n} epochs at {imgsz}px on device {device}."
msgid_plural "Training {model} for {n} epochs at {imgsz}px on device {device}."
msgstr[0] "Trening {model} przez {n} epokę, rozmiar {imgsz}px, urządzenie {device}."
msgstr[1] "Trening {model} przez {n} epoki, rozmiar {imgsz}px, urządzenie {device}."
msgstr[2] "Trening {model} przez {n} epok, rozmiar {imgsz}px, urządzenie {device}."

#: worker/commands/train.py:232
msgid "Training finished but no weights file was written, so there is nothing to export in Step 6."
msgstr "Trening się zakończył, ale nie zapisano pliku wag, więc w kroku 6 nie ma czego eksportować."

#: worker/commands/train.py:236
msgid "Remove \"save=false\" from the additional settings and train again."
msgstr "Usuń „save=false” z dodatkowych ustawień i uruchom trening ponownie."

#: worker/commands/train.py:240
msgid "Finished {n} epoch in {duration}."
msgid_plural "Finished {n} epochs in {duration}."
msgstr[0] "Ukończono {n} epokę w czasie {duration}."
msgstr[1] "Ukończono {n} epoki w czasie {duration}."
msgstr[2] "Ukończono {n} epok w czasie {duration}."

#: worker/commands/train.py:277
msgid "{folder} does not hold a prepared dataset. Run Step 2 again."
msgstr "{folder} nie zawiera przygotowanego zbioru danych. Uruchom ponownie krok 2."

#: worker/commands/train.py:281
msgid "{file} is missing, so there is nothing to point the trainer at. Run Step 2 again."
msgstr "Brakuje pliku {file}, więc trening nie ma czego użyć jako opisu zbioru danych. Uruchom ponownie krok 2."

#: worker/commands/train.py:298
msgid "Not one photo has a label file, so there is nothing for the model to learn from. Run autolabeling in Step 3 first."
msgstr "Żadne zdjęcie nie ma pliku etykiet, więc model nie ma się z czego uczyć. Najpierw uruchom automatyczne etykietowanie w kroku 3."

#: worker/commands/train.py:306
msgid "Only {n} labelled photo(s) {in_classes}. A model trained on this few will report an accuracy that is mostly luck."
msgid_plural "Only {n} labelled photo(s) {in_classes}. A model trained on this few will report an accuracy that is mostly luck."
msgstr[0] "Tylko {n} zdjęcie z etykietami {in_classes}. Model wytrenowany na tak niewielu zdjęciach pokaże dokładność, która w dużej mierze jest dziełem przypadku."
msgstr[1] "Tylko {n} zdjęcia z etykietami {in_classes}. Model wytrenowany na tak niewielu zdjęciach pokaże dokładność, która w dużej mierze jest dziełem przypadku."
msgstr[2] "Tylko {n} zdjęć z etykietami {in_classes}. Model wytrenowany na tak niewielu zdjęciach pokaże dokładność, która w dużej mierze jest dziełem przypadku."

#: worker/commands/train.py:312
msgid "in {n} class(es)"
msgid_plural "in {n} class(es)"
msgstr[0] "w {n} klasie"
msgstr[1] "w {n} klasach"
msgstr[2] "w {n} klasach"

#: worker/commands/train.py:314
msgid "More photos is the single biggest improvement available here."
msgstr "Więcej zdjęć to zdecydowanie największa poprawa, jaką można tu osiągnąć."

#: worker/commands/train.py:317
msgid "Training on {n:,} labelled photos {in_classes}."
msgid_plural "Training on {n:,} labelled photos {in_classes}."
msgstr[0] "Trening na {n:,} zdjęciu z etykietami {in_classes}."
msgstr[1] "Trening na {n:,} zdjęciach z etykietami {in_classes}."
msgstr[2] "Trening na {n:,} zdjęciach z etykietami {in_classes}."

#: worker/commands/train.py:321
msgid "in {n} classes"
msgid_plural "in {n} classes"
msgstr[0] "w {n} klasie"
msgstr[1] "w {n} klasach"
msgstr[2] "w {n} klasach"

#: worker/commands/train.py:345
msgid "{file} cannot be read: {error}"
msgstr "Nie można odczytać pliku {file}: {error}"

#: worker/commands/train.py:350
msgid "{file} is empty. Run Step 2 again."
msgstr "Plik {file} jest pusty. Uruchom ponownie krok 2."

#: worker/commands/train.py:359
msgid "\"{name}\" cannot be used as a folder name for this run."
msgstr "„{name}” nie może być nazwą folderu tego przebiegu."

#: worker/commands/train.py:366
msgid "\"{name}\" already exists. Choose another name, or agree to replace it."
msgstr "„{name}” już istnieje. Wybierz inną nazwę albo zgódź się na zastąpienie."

#: worker/commands/train.py:375
msgid "{folder} is not empty and does not look like a training run this app made, so it will not be deleted. Choose another name for this run."
msgstr "Folder {folder} nie jest pusty i nie wygląda na przebieg treningu utworzony przez tę aplikację, więc nie zostanie usunięty. Wybierz inną nazwę dla tego przebiegu."

#: worker/commands/train.py:387
msgid "{folder} could not be emptied: {error}. Close anything that has a file in that folder open, or choose another name for this run."
msgstr "Nie udało się opróżnić folderu {folder}: {error}. Zamknij wszystko, co ma otwarty plik z tego folderu, albo wybierz inną nazwę dla tego przebiegu."

#: worker/commands/train.py:415
msgid "Ultralytics has no setting called {names}. Check the spelling in the additional settings box."
msgstr "Ultralytics nie rozpoznaje ustawień: {names}. Sprawdź pisownię w polu „Dodatkowe ustawienia”."

#: worker/commands/train.py:441
msgid "PyTorch cannot see a GPU, and training on the processor would take days rather than minutes."
msgstr "PyTorch nie widzi karty graficznej, a trening na procesorze trwałby dni zamiast minut."

#: worker/commands/train.py:497
msgid "{n} batches per epoch, {total:,} in total."
msgid_plural "{n} batches per epoch, {total:,} in total."
msgstr[0] "{n} partia na epokę, łącznie {total:,}."
msgstr[1] "{n} partie na epokę, łącznie {total:,}."
msgstr[2] "{n} partii na epokę, łącznie {total:,}."

#: worker/commands/train.py:522
msgid "Out of GPU memory; restarting epoch {epoch} with batch size {batch}."
msgstr "Zabrakło pamięci GPU; epoka {epoch} zaczyna się od nowa z rozmiarem partii {batch}."

#: worker/commands/train.py:530
msgid "Out of GPU memory; restarting epoch {epoch} with a smaller batch."
msgstr "Zabrakło pamięci GPU; epoka {epoch} zaczyna się od nowa z mniejszą partią."

#: worker/commands/train.py:592
msgid "epoch {epoch} of {total}"
msgstr "epoka {epoch} z {total}"

#: worker/commands/train.py:688
msgid "Epoch {epoch}/{total}"
msgstr "Epoka {epoch}/{total}"

#: worker/commands/train.py:693
msgid "(best so far)"
msgstr "(najlepsza do tej pory)"

#: worker/commands/train.py:731
msgid "INT8 quantisation-aware training needs the NVIDIA TensorRT Model Optimizer, and this environment cannot import it ({error})."
msgstr "Trening INT8 z uwzględnieniem kwantyzacji wymaga NVIDIA TensorRT Model Optimizer, a to środowisko nie może go zaimportować ({error})."

#: worker/commands/train.py:741
msgid "This version of Ultralytics cannot do INT8 quantisation-aware training. Update it in Step 1."
msgstr "Ta wersja Ultralytics nie obsługuje treningu INT8 z uwzględnieniem kwantyzacji. Zaktualizuj ją w kroku 1."

#: worker/commands/train.py:795
msgid "The INT8 quantisation kernels cannot be compiled: on Windows they need the Microsoft C++ compiler, and it was not found. Training will still be correct, but the quantised layers fall back to a slower implementation."
msgstr "Nie można skompilować jąder kwantyzacji INT8: w systemie Windows potrzebują kompilatora Microsoft C++, a nie został on znaleziony. Trening nadal będzie poprawny, ale warstwy kwantyzowane użyją wolniejszej implementacji."

#: worker/commands/train.py:800
msgid "Install the Visual Studio Build Tools with the \"Desktop development with C++\" workload, then start the run again. The app finds the compiler by itself; nothing needs to be added to PATH."
msgstr "Zainstaluj Visual Studio Build Tools z obciążeniem „Programowanie aplikacji klasycznych w języku C++”, a potem uruchom trening ponownie. Aplikacja sama znajdzie kompilator; nie trzeba niczego dodawać do PATH."

#: worker/commands/train.py:810
msgid "The INT8 quantisation kernels cannot be compiled: on Windows they need the NVIDIA CUDA Toolkit {version}, and it was not found. Training will still be correct, but the quantised layers fall back to a slower implementation."
msgstr "Nie można skompilować jąder kwantyzacji INT8: w systemie Windows potrzebują NVIDIA CUDA Toolkit {version}, a nie został on znaleziony. Trening nadal będzie poprawny, ale warstwy kwantyzowane użyją wolniejszej implementacji."

#: worker/commands/train.py:817
msgid "Install CUDA Toolkit {version} from NVIDIA, then start the run again. It can sit beside any other version: the app picks the one that matches."
msgstr "Zainstaluj CUDA Toolkit {version} ze strony NVIDIA, a potem uruchom trening ponownie. Może być zainstalowany obok dowolnej innej wersji: aplikacja wybierze tę, która pasuje."

#: worker/commands/train.py:828
msgid "ninja is not on this environment's PATH, so the INT8 quantisation kernels cannot be compiled. Training will still be correct, but the quantised layers fall back to a slower implementation."
msgstr "ninja nie ma w ścieżce PATH tego środowiska, więc nie można skompilować jąder kwantyzacji INT8. Trening nadal będzie poprawny, ale warstwy kwantyzowane użyją wolniejszej implementacji."

#: worker/commands/train.py:833
msgid "This is the app's mistake, not a missing package. Report it with the log file if this run is slower than you expect."
msgstr "To błąd aplikacji, a nie brakujący pakiet. Zgłoś go razem z plikiem dziennika, jeśli ten przebieg okaże się wolniejszy, niż oczekujesz."

#: worker/util/errors.py:29
msgid "Check the photo folder in Step 2: it needs one sub-folder per class, with that class's photos directly inside it."
msgstr "Sprawdź folder ze zdjęciami w kroku 2: musi zawierać jeden podfolder na każdą klasę, a zdjęcia danej klasy muszą leżeć bezpośrednio w nim."

#: worker/util/errors.py:39
msgid "Go back to Step 1 and let the app set up its Python environment again. If the driver is missing, install it first and restart the computer."
msgstr "Wróć do kroku 1 i pozwól aplikacji ponownie skonfigurować środowisko Pythona. Jeśli brakuje sterownika, najpierw go zainstaluj i uruchom ponownie komputer."

#: worker/util/errors.py:54
msgid "Open Step 1 and press Repair, which installs what the environment is missing without downloading everything again. Failing that, train with INT8 QAT switched off and choose INT8 when you export in Step 6: that quantises the finished model instead of training it to expect quantisation, which needs nothing extra and usually costs a little accuracy."
msgstr "Otwórz krok 1 i kliknij Napraw – zostanie doinstalowane to, czego brakuje w środowisku, bez ponownego pobierania wszystkiego. Jeśli to nie pomoże, trenuj z wyłączonym INT8 QAT i wybierz INT8 przy eksporcie w kroku 6: wtedy kwantyzowany jest gotowy model, zamiast trenować go z myślą o kwantyzacji. Nie wymaga to niczego dodatkowego i zwykle kosztuje odrobinę dokładności."

#: worker/util/errors.py:67
msgid "The model is downloaded once, the first time it is used, and needs an internet connection. Check the connection, or any proxy that blocks huggingface.co, and try again."
msgstr "Model jest pobierany raz, przy pierwszym użyciu, i wymaga połączenia z internetem. Sprawdź połączenie lub serwer proxy, który może blokować huggingface.co, i spróbuj ponownie."

#: worker/util/errors.py:78
msgid "ONNX is the format most likely to succeed; try it first to find out whether the problem is the model or the format. Exporting at FP32 also rules out the precision as the cause."
msgstr "Eksport do ONNX udaje się najczęściej; spróbuj go najpierw, aby ustalić, czy problem leży w modelu, czy w formacie. Eksport z precyzją FP32 pozwala też wykluczyć precyzję jako przyczynę."

#: worker/util/errors.py:94
msgid "Choose INT8 in the precision list. A model trained with INT8 QAT already carries its quantisers, and exporting it at any other precision throws that training away."
msgstr "Wybierz INT8 na liście precyzji. Model wytrenowany z INT8 QAT ma już wbudowane kwantyzatory, a eksport z jakąkolwiek inną precyzją zaprzepaszcza ten trening."

#: worker/util/errors.py:112
msgid "Try a different file to find out whether the problem is this one or the format. MP4 with H.264, and JPEG or PNG, are the safest to test with."
msgstr "Spróbuj innego pliku, aby ustalić, czy problem dotyczy tego pliku, czy formatu. Do testów najbezpieczniejsze są MP4 z H.264 oraz JPEG lub PNG."

#: worker/util/errors.py:127
msgid "Close anything else using the camera -- a video call or the system camera app -- and press Refresh. On Linux, check that your user is in the 'video' group."
msgstr "Zamknij wszystko inne, co korzysta z kamery – rozmowę wideo albo systemową aplikację aparatu – i kliknij Odśwież. W systemie Linux sprawdź, czy twój użytkownik należy do grupy „video”."

#: worker/util/errors.py:143
msgid "Export the model again in Step 6, or export it to ONNX, which is the format most likely to run anywhere. A TensorRT engine only works on the machine and driver that built it."
msgstr "Wyeksportuj model ponownie w kroku 6 albo wyeksportuj go do ONNX – to format, który najpewniej zadziała wszędzie. Silnik TensorRT działa tylko na komputerze i ze sterownikiem, na których został zbudowany."
